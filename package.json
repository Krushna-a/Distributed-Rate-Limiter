{
  "name": "distributed-rate-limiter",
  "version": "1.0.0",
  "description": "Production-grade distributed rate limiter with Redis (MERN Stack)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "benchmark": "k6 run benchmarks/k6/steady-load.js",
    "benchmark:concurrent": "k6 run benchmarks/k6/concurrent-burst.js",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write \"src/**/*.js\""
  },
  "keywords": [
    "rate-limiter",
    "distributed-systems",
    "redis",
    "middleware",
    "mern",
    "express",
    "nodejs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "prom-client": "^15.1.0",
    "winston": "^3.11.0",
    "lru-cache": "^10.1.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "ioredis-mock": "^8.9.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1"
  }
}
